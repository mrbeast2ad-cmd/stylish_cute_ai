# Copy to .env — NEVER commit the real .env or the service-account JSON file.

# Path to the Firebase service-account key JSON you download from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Your Firebase Realtime Database URL (same one from firebase-config.js)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# The email of the account you log into the web dashboard with
REMOTE_ACCOUNT_EMAIL=you@example.com
